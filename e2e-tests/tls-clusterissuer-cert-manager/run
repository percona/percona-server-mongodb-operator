#!/bin/bash

set -o errexit

test_dir=$(realpath $(dirname $0))
. "${test_dir}/../functions"
set_debug

# certificate issuance is under test, so cert-manager failures must fail the test
export CERT_RACE_WORKAROUND=0

check_tls_secret() {
	local secret_name=$1
	check_secret_data_key "$secret_name" 'ca.crt'
	check_secret_data_key "$secret_name" 'tls.crt'
	check_secret_data_key "$secret_name" 'tls.key'
}

check_secret_data_key() {
	local secret_name=$1
	local data_key=$2
	local secret_data

	secret_data=$(kubectl_bin get "secrets/${secret_name}" -o json | jq ".data[\"${data_key}\"]")
	if [ -z "$secret_data" ]; then
		exit 1
	fi
}

create_clusterissuer_rbac() {
	local cluster_issuer_name=$1
	local operator_sa=${2:-percona-server-mongodb-operator}

	kubectl_bin create clusterrole "${cluster_issuer_name}-reader" \
		--verb=get,list,watch,create,update,patch \
		--resource=clusterissuers.cert-manager.io \
		--dry-run=client -o yaml | kubectl_bin apply -f -

	kubectl_bin create clusterrolebinding "${cluster_issuer_name}-reader-${namespace}" \
		--clusterrole="${cluster_issuer_name}-reader" \
		--serviceaccount="${OPERATOR_NS:-$namespace}:${operator_sa}" \
		--dry-run=client -o yaml | kubectl_bin apply -f -
}

delete_clusterissuer_rbac() {
	local cluster_issuer_name=$1

	kubectl_bin delete clusterrolebinding "${cluster_issuer_name}-reader-${namespace}" --ignore-not-found
	kubectl_bin delete clusterrole "${cluster_issuer_name}-reader" --ignore-not-found
}

check_certificate_field() {
	local certificate=$1
	local jsonpath=$2
	local expected=$3
	local actual

	actual=$(kubectl_bin get certificate "$certificate" -o "jsonpath={${jsonpath}}")
	if [ "$actual" != "$expected" ]; then
		echo "certificate/${certificate} ${jsonpath} is '${actual}', expected '${expected}'"
		exit 1
	fi
}

check_certificates_use_user_clusterissuer() {
	local certificate

	for certificate in "$@"; do
		check_certificate_field "$certificate" '.metadata.ownerReferences[0].kind' 'PerconaServerMongoDB'
		check_certificate_field "$certificate" '.spec.issuerRef.kind' 'ClusterIssuer'
		check_certificate_field "$certificate" '.spec.issuerRef.name' "$cluster-psmdb-issuer"
	done
}

check_tls_disabled() {
	local sts=$1
	local container=$2
	local args

	args=$(kubectl_bin get statefulset "$sts" -o "jsonpath={.spec.template.spec.containers[?(@.name==\"${container}\")].args}")
	if [[ $args != *--tlsMode=disabled* ]]; then
		echo "statefulset/${sts} ${container} args lack --tlsMode=disabled: ${args}"
		exit 1
	fi
}

check_issuer_not_created() {
	local issuer_name=$1
	local found

	found=$(kubectl_bin get issuer "$issuer_name" --ignore-not-found -o 'jsonpath={.metadata.name}')

	if [ -n "$found" ]; then
		echo "Issuer $issuer_name should not be created when ClusterIssuer is configured"
		exit 1
	fi
}

check_certificates_not_reissued() {
	local wait_time=$1
	shift
	local certificates=("$@")
	local revisions=()
	local certificate
	local new_revision
	local i

	for certificate in "${certificates[@]}"; do
		wait_certificate "$certificate"
		revisions+=("$(kubectl_bin get certificate "$certificate" -o 'jsonpath={.status.revision}')")
	done

	sleep "$wait_time"

	for i in "${!certificates[@]}"; do
		certificate="${certificates[$i]}"
		new_revision=$(kubectl_bin get certificate "$certificate" -o 'jsonpath={.status.revision}')
		if [ "${revisions[$i]}" != "$new_revision" ]; then
			echo "Certificate $certificate is continuously reissued: revision ${revisions[$i]} -> $new_revision"
			kubectl_bin describe certificate "$certificate"
			exit 1
		fi
	done
}

check_operator_cannot_read_clusterissuers() {
	local operator_sa=${1:-percona-server-mongodb-operator}
	local can_i
	local exit_status

	set +e
	can_i=$(kubectl auth can-i get clusterissuers.cert-manager.io \
		--all-namespaces \
		--as="system:serviceaccount:${OPERATOR_NS:-$namespace}:${operator_sa}" 2>&1)
	exit_status=$?
	set -e

	if [ "$exit_status" -eq 0 ] || [[ $can_i != no* ]]; then
		echo "Operator service account should not be able to get clusterissuers.cert-manager.io"
		echo "$can_i"
		exit 1
	fi
}

main() {
	if [ -z "$OPERATOR_NS" ]; then
		echo "Skipping the test. This test runs only in cluster-wide mode"
		exit 0
	fi

	create_infra "$namespace"
	deploy_cert_manager

	cluster="some-name"

	desc 'step 1: operator preserves user-created certificates when it has RBAC to read ClusterIssuers'
	create_clusterissuer_rbac "$cluster-psmdb-ca-issuer"
	create_clusterissuer_rbac "$cluster-psmdb-issuer"

	desc 'create secrets and start client'
	kubectl_bin apply -f "$conf_dir/secrets.yml"
	kubectl_bin apply -f "$conf_dir/client_with_tls.yml"

	desc 'create custom cert-manager issuers and certificates'
	kubectl_bin apply -f "$test_dir/conf/some-name-ca-cert.yml"
	kubectl_bin apply -f "$test_dir/conf/some-name-ssl-internal.yml"
	kubectl_bin apply -f "$test_dir/conf/some-name-ssl.yml"
	kubectl_bin apply -f "$test_dir/conf/some-name-psmdb-ca-issuer.yml"
	kubectl_bin apply -f "$test_dir/conf/some-name-psmdb-issuer.yml"
	deploy_cmctl
	sleep 60

	desc "create first PSMDB cluster $cluster"
	apply_cluster "$test_dir/conf/$cluster.yml"

	desc 'check if all Pods started'
	wait_for_running $cluster-rs0 3
	wait_for_running $cluster-cfg 3 "false"
	wait_for_running $cluster-mongos 3

	desc 'check user certificates are preserved'
	check_certificate_field "${cluster}-ssl" '.spec.subject.organizations[0]' 'CUSTOM'
	check_certificate_field "${cluster}-ssl-internal" '.spec.subject.organizations[0]' 'CUSTOM'

	desc 'step 2: operator creates certificates using the existing user ClusterIssuer when it has no RBAC to read ClusterIssuers'
	delete_clusterissuer_rbac "$cluster-psmdb-ca-issuer"
	delete_clusterissuer_rbac "$cluster-psmdb-issuer"
	check_operator_cannot_read_clusterissuers

	desc 'delete cluster'
	kubectl delete psmdb --all
	wait_for_delete psmdb/$cluster 180

	kubectl delete pvc --all
	kubectl_bin delete secret "$cluster-ssl-old" "$cluster-ssl-internal-old" --ignore-not-found

	desc 'delete user certificates so operator recreates them using the existing clusterissuer'
	kubectl_bin delete -f "$test_dir/conf/some-name-ssl.yml" --ignore-not-found
	kubectl_bin delete -f "$test_dir/conf/some-name-ssl-internal.yml" --ignore-not-found

	desc "recreate PSMDB cluster $cluster without clusterissuer RBAC"
	apply_cluster "$test_dir/conf/$cluster.yml"

	desc 'check if all Pods started'
	wait_for_running $cluster-rs0 3
	wait_for_running $cluster-cfg 3 "false"
	wait_for_running $cluster-mongos 3

	desc 'check certificates use the user clusterissuer without clusterissuer RBAC'
	check_certificates_use_user_clusterissuer "${cluster}-ssl" "${cluster}-ssl-internal"

	desc 'delete cluster'
	kubectl delete psmdb --all
	wait_for_delete psmdb/$cluster 180

	kubectl delete pvc --all

	desc 'step 3: operator issues certificates with the user ClusterIssuer and leaves it untouched'
	create_clusterissuer_rbac "$cluster-psmdb-ca-issuer"
	create_clusterissuer_rbac "$cluster-psmdb-issuer"

	kubectl_bin delete secret "$cluster-ssl" "$cluster-ssl-internal" "$cluster-ssl-old" "$cluster-ssl-internal-old" --ignore-not-found

	desc "recreate PSMDB cluster $cluster with clusterissuer RBAC"
	apply_cluster "$test_dir/conf/$cluster.yml"

	desc 'check if all Pods started'
	wait_for_running $cluster-rs0 3
	wait_for_running $cluster-cfg 3 "false"
	wait_for_running $cluster-mongos 3

	desc 'check certificates are issued by the user clusterissuer'
	check_certificates_use_user_clusterissuer "${cluster}-ssl" "${cluster}-ssl-internal"

	desc 'check operator does not create namespaced issuers'
	check_issuer_not_created "$cluster-psmdb-issuer"
	check_issuer_not_created "$cluster-psmdb-ca-issuer"

	desc 'check certificates are not continuously reissued'
	check_certificates_not_reissued 60 "$cluster-ssl" "$cluster-ssl-internal"

	desc 'check cluster is still ready'
	wait_for_cluster_state "${cluster}" "ready"

	desc 'delete cluster'
	kubectl delete psmdb --all
	wait_for_delete psmdb/$cluster 180

	kubectl delete pvc --all

	desc 'step 4: operator creates its own ClusterIssuer and certificates when no user ClusterIssuer exists'

	desc 'delete custom cert-manager issuers and certificates'
	kubectl_bin delete -f "$test_dir/conf/some-name-psmdb-ca-issuer.yml" --ignore-not-found
	kubectl_bin delete -f "$test_dir/conf/some-name-psmdb-issuer.yml" --ignore-not-found
	kubectl_bin delete -f "$test_dir/conf/some-name-ca-cert.yml" --ignore-not-found
	kubectl_bin delete -f "$test_dir/conf/some-name-ssl-internal.yml" --ignore-not-found
	kubectl_bin delete -f "$test_dir/conf/some-name-ssl.yml" --ignore-not-found

	sleep 30

	desc "recreate PSMDB cluster $cluster"
	apply_cluster "$test_dir/conf/$cluster.yml"

	desc 'check if all Pods started'
	wait_for_running $cluster-rs0 3
	wait_for_running $cluster-cfg 3 "false"
	wait_for_running $cluster-mongos 3

	desc 'check if certificates issued with certmanager'
	check_tls_secret "$cluster-ssl"

	renew_certificate "some-name-ssl"
	sleep 10
	wait_for_running $cluster-rs0 3
	wait_for_running $cluster-cfg 3 "false"
	wait_for_running $cluster-mongos 3

	renew_certificate "some-name-ssl-internal"
	sleep 10
	wait_for_running $cluster-rs0 3
	wait_for_running $cluster-cfg 3 "false"
	wait_for_running $cluster-mongos 3

	desc 'disable TLS'
	pause_cluster "$cluster"
	wait_for_cluster_state "${cluster}" "paused"

	disable_tls "$cluster"

	unpause_cluster "$cluster"
	wait_for_cluster_state "${cluster}" "ready"

	check_tls_disabled "${cluster}-rs0" mongod
	check_tls_disabled "${cluster}-cfg" mongod
	check_tls_disabled "${cluster}-mongos" mongos

	delete_clusterissuer_rbac "$cluster-psmdb-ca-issuer"
	delete_clusterissuer_rbac "$cluster-psmdb-issuer"

	destroy "$namespace"
	desc 'test passed'
}

main
