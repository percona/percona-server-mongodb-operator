#!/bin/bash

set -o errexit

test_dir=$(realpath $(dirname $0))
. ${test_dir}/../functions
set_debug

CLUSTER='some-name'

main() {
	create_infra $namespace

	desc 'create secrets and start client'
	kubectl_bin apply -f "${conf_dir}/client.yml" -f "${conf_dir}/secrets.yml"

	desc "create first PSMDB cluster 1.22.0 $CLUSTER"
	apply_cluster "$test_dir/conf/${CLUSTER}-rs0.yml"

	desc 'check if Pod started'
	wait_for_running "${CLUSTER}-rs0" "3" "true"

	compare_generation "1" "statefulset" "${CLUSTER}-rs0"

	desc 'test 1.23.1'
	kubectl_bin patch psmdb "${CLUSTER}" --type=merge --patch '{
        "spec": {"crVersion":"1.23.1"}
    }'
	# Wait for at least one reconciliation
	sleep 10
	desc 'check if Pod started'
	wait_for_running "${CLUSTER}-rs0" "3" "true"

	compare_generation "2" "statefulset" "${CLUSTER}-rs0"

	desc 'test 1.24.0'
	kubectl_bin patch psmdb "${CLUSTER}" --type=merge --patch '{
        "spec": {"crVersion":"1.24.0"}
    }'
	# Wait for at least one reconciliation
	sleep 10
	desc 'check if Pod started'
	wait_for_running "${CLUSTER}-rs0" "3" "true"

	compare_generation "3" "statefulset" "${CLUSTER}-rs0"

	destroy $namespace

	desc 'test passed'
}

main
