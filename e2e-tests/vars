#!/usr/bin/env bash

with_registry() {
	local ref="$1"

	case "$ref" in
		*.*/*|*:*/*|localhost/*)
			printf '%s' "$ref"
			;;
		percona/*|perconalab/*)
			printf '%s/%s' "${REGISTRY_NAME%/}" "$ref"
			;;
		*)
			printf '%s' "$ref"
			;;
	esac
}

qualify_image_var() {
	local var="$1"
	local val="${!var}"

	[[ -z $val ]] && return

	if [[ $val == *$'\n'* ]]; then
		local out="" ref

		while IFS= read -r ref; do
			[[ -n $ref ]] && out+="$(with_registry "$ref")"$'\n'
		done <<<"$val"

		val="${out%$'\n'}"
	else
		val="$(with_registry "$val")"
	fi

	printf -v "$var" '%s' "$val"
}

setup_logging() {
	if [[ ${ENABLE_LOGGING} == true ]]; then
		echo "Debug logging enabled. Logs will be saved to $logs_dir/$test_name.log"
		mkdir -p "$logs_dir"
		exec &> >(tee "$logs_dir/$test_name.log")
		echo "Log: $logs_dir/$test_name.log"
	else
		echo "Debug logging disabled."
	fi
}

# Shared env (images, platform, versions, flags) is set by init_env in conftest.py
if [[ ${E2E_ENV_INITIALIZED} != 1 ]]; then
	echo "ERROR: e2e env is not initialized. Running test scripts directly is no longer supported." >&2
	echo "Run the test via pytest instead: make e2e-test TEST=$(basename "$test_dir")" >&2
	exit 1
fi

# Test variables
export tmp_dir=$(mktemp -d)
export sed=$(command -v gsed || command -v sed)
export date=$(command -v gdate || command -v date)
export test_name=$(basename "$test_dir")
export namespace="${test_name}-${RANDOM}"
export arbiter_namespace="${test_name}-arbiter-${RANDOM}"
export replica_namespace="${test_name}-replica-${RANDOM}"
export conf_dir=$(realpath "$test_dir/../conf" || :)
export src_dir=$(realpath "$test_dir/../..")
export logs_dir="$test_dir/../logs"

# Test logging
setup_logging
