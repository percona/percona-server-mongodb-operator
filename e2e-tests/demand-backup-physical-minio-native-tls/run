#!/bin/bash

set -o errexit

test_dir=$(realpath "$(dirname "$0")")
. "${test_dir}/../functions"
set_debug

create_infra "${namespace}"

desc 'Deploy cert-manager for proper certificate generation'
deploy_cert_manager

desc 'Create self-signed issuer'
kubectl_bin apply -f - <<EOF
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: selfsigned-issuer
  namespace: ${namespace}
spec:
  selfSigned: {}
EOF

###############################################################################
# Phase 1: First SeaweedFS instance
###############################################################################

desc 'Generate certificate for first SeaweedFS instance via cert-manager'

kubectl_bin apply -f - <<EOF
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: s3-cert
  namespace: ${namespace}
spec:
  secretName: s3-tls-temp
  issuerRef:
    name: selfsigned-issuer
    kind: Issuer
  commonName: s3-storage-all-in-one
  dnsNames:
  - s3-storage-all-in-one
  - s3-storage-all-in-one.${namespace}
  - s3-storage-all-in-one.${namespace}.svc
  - s3-storage-all-in-one.${namespace}.svc.cluster.local
  usages:
  - digital signature
  - key encipherment
  - server auth
EOF

kubectl_bin wait --for=condition=Ready certificate/s3-cert \
  -n ${namespace} --timeout=120s

kubectl_bin get secret s3-tls-temp -n ${namespace} \
  -o jsonpath='{.data.tls\.crt}' | base64 -d > /tmp/s3-cert.pem

kubectl_bin get secret s3-tls-temp -n ${namespace} \
  -o jsonpath='{.data.tls\.key}' | base64 -d > /tmp/s3-key.pem

kubectl_bin create secret tls s3-tls -n ${namespace} \
  --cert=/tmp/s3-cert.pem \
  --key=/tmp/s3-key.pem

kubectl_bin create secret generic s3-ca-bundle -n ${namespace} \
  --from-file=ca.crt=/tmp/s3-cert.pem

desc 'Deploy first SeaweedFS instance with TLS'
deploy_s3_storage s3-tls
apply_s3_storage_secrets

kubectl_bin apply -f "${test_dir}/conf/secondary-s3-secret.yml"

###############################################################################
# Phase 1: Single CA bundle test
###############################################################################

cluster="some-name"

kubectl_bin apply -f "${test_dir}/conf/secrets.yml"
kubectl_bin apply -f "${conf_dir}/client_with_tls.yml"
apply_cluster "${test_dir}/conf/${cluster}-single-ca.yml"

wait_for_running ${cluster}-rs0 3
wait_cluster_consistency ${cluster}

###############################################################################
# Verify CA bundle
###############################################################################

desc 'Verify CA bundle infrastructure'

kubectl_bin exec ${cluster}-rs0-0 -n ${namespace} -c backup-agent -- \
  test -f /etc/s3/certs/ca-bundle.crt

kubectl_bin exec ${cluster}-rs0-0 -n ${namespace} -c backup-agent -- \
  env | grep SSL_CERT_FILE

cert_count=$(kubectl_bin exec ${cluster}-rs0-0 -n ${namespace} -c backup-agent -- \
  grep -c "BEGIN CERTIFICATE" /etc/s3/certs/ca-bundle.crt)

[ "$cert_count" = "1" ]

###############################################################################
# Phase 2: Second SeaweedFS instance
###############################################################################

desc 'Generate certificate for secondary SeaweedFS instance'

kubectl_bin apply -f - <<EOF
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: secondary-s3-cert
  namespace: ${namespace}
spec:
  secretName: secondary-s3-tls-temp
  issuerRef:
    name: selfsigned-issuer
    kind: Issuer
  commonName: secondary-s3-storage-all-in-one
  dnsNames:
  - secondary-s3-storage-all-in-one
  - secondary-s3-storage-all-in-one.${namespace}
  - secondary-s3-storage-all-in-one.${namespace}.svc
  - secondary-s3-storage-all-in-one.${namespace}.svc.cluster.local
  usages:
  - digital signature
  - key encipherment
  - server auth
EOF

kubectl_bin wait --for=condition=Ready certificate/secondary-s3-cert \
  -n ${namespace} --timeout=120s

kubectl_bin get secret secondary-s3-tls-temp -n ${namespace} \
  -o jsonpath='{.data.tls\.crt}' | base64 -d > /tmp/secondary-s3-cert.pem

kubectl_bin get secret secondary-s3-tls-temp -n ${namespace} \
  -o jsonpath='{.data.tls\.key}' | base64 -d > /tmp/secondary-s3-key.pem

kubectl_bin create secret tls secondary-s3-tls -n ${namespace} \
  --cert=/tmp/secondary-s3-cert.pem \
  --key=/tmp/secondary-s3-key.pem

kubectl_bin create secret generic secondary-s3-ca-bundle -n ${namespace} \
  --from-file=ca.crt=/tmp/secondary-s3-cert.pem

deploy_s3_storage "secondary-s3-tls" "secondary-s3-storage"

desc "Add second storage (secondary)"

kubectl_bin patch psmdb ${cluster} -n ${namespace} --type=merge -p '
{
  "spec": {
    "backup": {
      "storages": {
        "secondary": {
          "type": "minio",
          "minio": {
            "credentialsSecret": "secondary-s3-secret",
            "region": "us-east-1",
            "bucket": "operator-testing",
            "endpointUrl": "https://secondary-s3-storage-all-in-one:8443",
            "secure": true,
            "insecureSkipTLSVerify": false,
            "caBundle": {
              "name": "secondary-s3-ca-bundle",
              "key": "ca.crt"
            }
          }
        }
      }
    }
  }
}'

sleep 300
wait_cluster_consistency ${cluster}

desc "Verify merged CA bundle"
cert_count=$(kubectl_bin exec ${cluster}-rs0-0 -n ${namespace} -c backup-agent -- \
  grep -c "BEGIN CERTIFICATE" /etc/s3/certs/ca-bundle.crt)

[ "$cert_count" = "2" ]

desc 'Backup & restore with merged CA'

wait_for_pbm_operations ${cluster}

run_mongo_tls \
  'db.createUser({user:"myApp",pwd:"myPass",roles:[{db:"myApp",role:"readWrite"}]})' \
  "userAdmin:userAdmin123456@${cluster}-rs0.${namespace}"

run_mongo_tls \
  'db.getSiblingDB("myApp").test.insert({ x: 100500 })' \
  "myApp:myPass@${cluster}-rs0.${namespace}"

backup_name_single="backup-local-s3"
run_backup local-s3 ${backup_name_single} 'physical'
wait_backup "${backup_name_single}"

check_backup_in_storage ${backup_name_single} local-s3 rs0 filelist.pbm https

run_mongo_tls \
  'db.getSiblingDB("myApp").test.drop()' \
  "myApp:myPass@${cluster}-rs0.${namespace}"

run_restore ${backup_name_single}
run_recovery_check ${backup_name_single} "" "" "true"

rm -f /tmp/s3-cert.pem /tmp/s3-key.pem
rm -f /tmp/secondary-s3-cert.pem /tmp/secondary-s3-key.pem

destroy "${namespace}"

desc 'test passed'
