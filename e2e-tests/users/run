#!/bin/bash

set -o errexit

test_dir=$(realpath "$(dirname "$0")")
. "${test_dir}/../functions"
set_debug

newpass="test-password"
newpassencrypted=$(echo -n "$newpass" | base64)
tag_value=$'h8V"k3N\'$(r7B)\nx2M'

create_infra "$namespace"

deploy_s3_storage

desc 'create secrets and start client'
kubectl_bin apply -f "${conf_dir}/client.yml" \
	-f "${test_dir}/conf/secrets.yml" \
	-f "${conf_dir}/s3-secret.yml"

init_user=$(getUserData "some-users" "MONGODB_USER_ADMIN_USER")
init_password=$(getUserData "some-users" "MONGODB_USER_ADMIN_PASSWORD")

cluster="some-name-rs0"
desc "create first PSMDB cluster $cluster"
apply_cluster "$test_dir/conf/$cluster.yml"
desc 'Check if all 3 Pods started'
wait_for_running $cluster 3

mongo_shell=$(kubectl_bin exec "$cluster-0" -c mongod -- sh -c \
	'if command -v mongosh >/dev/null; then echo mongosh; else echo mongo; fi')

desc 'authenticate with the escaped user name and password'
check_mongo_auth "$init_user:$init_password@$cluster-0.$cluster.$namespace"

desc 'check the replica set tag survived rs.initiate'
actual_tag=$(kubectl_bin exec "$cluster-0" -c mongod -- \
	"$mongo_shell" --quiet --host localhost --authenticationDatabase admin \
	--username clusterAdmin --password clusterAdmin123456 \
	--eval 'print(rs.conf().members[0].tags.special)')
if [[ $actual_tag != "$tag_value" ]]; then
	printf 'ERROR: replica set tag mismatch: expected %q, got %q\n' "$tag_value" "$actual_tag" >&2
	exit 1
fi

backup_name="backup-local-s3"
psmdb="some-name"

# Prints "pod uid restartCount" of a container for each cluster pod and checks
# that all three pods were read.
container_restarts() {
	local container=$1 out
	out=$(kubectl_bin get pods -l app.kubernetes.io/instance="$psmdb" -o json \
		| jq -r --arg c "$container" '.items[] | "\(.metadata.name) \(.metadata.uid) \(
			[.status.containerStatuses[] | select(.name == $c) | .restartCount] | first)"' | sort)
	if [[ $(wc -l <<<"$out") -ne 3 ]]; then
		echo "ERROR: expected 3 pods with ${container}, got: ${out}" >&2
		exit 1
	fi
	echo "$out"
}

# Waits until the operator applied a users secret change: MongoDB has the new
# users, the cluster is ready, and every pod is Ready. With the backup-agent
# restarts from before the change as argument, it also waits until each agent
# restarted (or its pod was replaced), so it runs with the new credentials.
wait_users_applied() {
	local agents_before=$1 agents start=$SECONDS

	wait_for_users_synced "$psmdb"
	if [[ -n $agents_before ]]; then
		echo -n "waiting for the backup agents to restart"
		until
			agents=$(container_restarts backup-agent)
			awk 'NR == FNR { uid[$1] = $2; n[$1] = $3; next }
				!($1 in uid) || ($2 == uid[$1] && $3 <= n[$1]) { stale = 1 }
				END { exit stale }' <(echo "$agents_before") <(echo "$agents")
		do
			if ((SECONDS - start >= 300)); then
				echo
				echo "ERROR: backup agents did not restart in 300s, before: ${agents_before}, now: ${agents}" >&2
				exit 1
			fi
			echo -n .
			sleep 5
		done
		echo ".OK"
	fi
	wait_cluster_consistency "$psmdb"
	kubectl_bin wait --for=condition=Ready pod -l app.kubernetes.io/instance="$psmdb" --timeout=300s
}

mongod_before=$(container_restarts mongod)

desc 'change MONGODB_DATABASE_ADMIN_PASSWORD'
patch_secret "some-users" "MONGODB_DATABASE_ADMIN_PASSWORD" "$newpassencrypted"
wait_users_applied

user=$(getUserData "some-users" "MONGODB_DATABASE_ADMIN_USER")
check_mongo_auth "$user:$newpass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-2.$cluster.$namespace"

desc 'change MONGODB_BACKUP_PASSWORD'
agents=$(container_restarts backup-agent)
patch_secret "some-users" "MONGODB_BACKUP_PASSWORD" "$newpassencrypted"
wait_users_applied "$agents"
user=$(getUserData "some-users" "MONGODB_BACKUP_USER")
check_mongo_auth "$user:$newpass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-2.$cluster.$namespace"

desc 'change MONGODB_BACKUP_USER'
agents=$(container_restarts backup-agent)
newnameencrypted=$(echo -n "backup2" | base64)
patch_secret "some-users" "MONGODB_BACKUP_USER" "$newnameencrypted"
wait_users_applied "$agents"
user=$(getUserData "some-users" "MONGODB_BACKUP_USER")
check_mongo_auth "$user:$newpass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-2.$cluster.$namespace"

desc 'run backup'
run_backup local-s3
wait_backup "$backup_name"

desc 'change MONGODB_USER_ADMIN_PASSWORD'
patch_secret "some-users" "MONGODB_USER_ADMIN_PASSWORD" "$newpassencrypted"
wait_users_applied
user=$(getUserData "some-users" "MONGODB_USER_ADMIN_USER")
check_mongo_auth "$user:$newpass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-2.$cluster.$namespace"

desc 'change MONGODB_USER_ADMIN_USER'
newnameencrypted=$(echo -n "userAdmin2" | base64)
patch_secret "some-users" "MONGODB_USER_ADMIN_USER" "$newnameencrypted"
wait_users_applied
user=$(getUserData "some-users" "MONGODB_USER_ADMIN_USER")
check_mongo_auth "$user:$newpass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-2.$cluster.$namespace"

desc 'change MONGODB_CLUSTER_ADMIN_PASSWORD'
patch_secret "some-users" "MONGODB_CLUSTER_ADMIN_PASSWORD" "$newpassencrypted"
wait_users_applied
user=$(getUserData "some-users" "MONGODB_CLUSTER_ADMIN_USER")
check_mongo_auth "$user:$newpass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-2.$cluster.$namespace"

desc 'change MONGODB_CLUSTER_MONITOR_PASSWORD'
patch_secret "some-users" "MONGODB_CLUSTER_MONITOR_PASSWORD" "$newpassencrypted"
wait_users_applied
user=$(getUserData "some-users" "MONGODB_CLUSTER_MONITOR_USER")
check_mongo_auth "$user:$newpass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$newpass@$cluster-2.$cluster.$namespace"

desc 'remove users secret'
agents=$(container_restarts backup-agent)
kubectl_bin delete secret some-users
wait_users_applied "$agents"
user=$(getUserData "some-users" "MONGODB_USER_ADMIN_USER")
pass=$(getUserData "some-users" "MONGODB_USER_ADMIN_PASSWORD")
check_mongo_auth "$user:$pass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$pass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$pass@$cluster-2.$cluster.$namespace"

desc 'update all users'
agents=$(container_restarts backup-agent)
kubectl_bin apply -f "${conf_dir}/secrets.yml"
wait_users_applied "$agents"
user=$(getUserData "some-users" "MONGODB_USER_ADMIN_USER")
pass=$(getUserData "some-users" "MONGODB_USER_ADMIN_PASSWORD")
check_mongo_auth "$user:$pass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$pass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$pass@$cluster-2.$cluster.$namespace"

newmonitorusername="newmonitorusername"
desc 'update monitor user username'
patch_secret "some-users" "MONGODB_CLUSTER_MONITOR_USER" "$(echo -n "$newmonitorusername" | base64)"
wait_users_applied
user=$(getUserData "some-users" "MONGODB_CLUSTER_MONITOR_USER")
pass=$(getUserData "some-users" "MONGODB_CLUSTER_MONITOR_PASSWORD")
check_mongo_auth "$user:$pass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$pass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$pass@$cluster-2.$cluster.$namespace"

desc 'secret without userAdmin'
agents=$(container_restarts backup-agent)
kubectl_bin apply -f "${test_dir}/conf/secrets-2.yml"
wait_users_applied "$agents"
user=$(getUserData "some-users" "MONGODB_USER_ADMIN_USER")
pass=$(getUserData "some-users" "MONGODB_USER_ADMIN_PASSWORD")
check_mongo_auth "$user:$pass@$cluster-0.$cluster.$namespace"
check_mongo_auth "$user:$pass@$cluster-1.$cluster.$namespace"
check_mongo_auth "$user:$pass@$cluster-2.$cluster.$namespace"

desc 'no mongod restarts during the user changes'
mongod_after=$(container_restarts mongod)
if [[ $mongod_after != "$mongod_before" ]]; then
	echo "ERROR: mongod restarted while system users changed (pod uid restarts), before:" >&2
	echo "$mongod_before" >&2
	echo "after:" >&2
	echo "$mongod_after" >&2
	exit 1
fi

destroy "$namespace"

desc 'test passed'
