#!/bin/bash

set -o xtrace
set -o errexit

dir=$(realpath "$(dirname "$0")")

run() {
	local test=$1
	make -C "$dir/.." e2e-test TEST="$test" || {
		echo "test $test failed"
		exit 1
	}
}

run arbiter
run cross-site-sharded
run data-at-rest-encryption
run data-sharded
run default-cr
run demand-backup-eks-credentials
run demand-backup-eks-credentials-irsa
run demand-backup-sharded
run demand-backup
run demand-backup-physical-parallel
run demand-backup-physical-aws
run demand-backup-physical-azure
run demand-backup-physical-gcp
run demand-backup-physical-minio
run demand-backup-physical-sharded-parallel
run demand-backup-physical-sharded-aws
run demand-backup-physical-sharded-azure
run demand-backup-physical-sharded-gcp
run demand-backup-physical-sharded-minio
run expose-sharded
run ignore-labels-annotations
run init-deploy
run finalizer
run limits
run liveness
run multi-cluster-service
run mongod-major-upgrade
run mongod-major-upgrade-sharded
run non-voting-and-hidden
run one-pod
run operator-self-healing-chaos
run pitr-sharded
run pitr
run recover-no-primary
run rs-shard-migration
run scaling
run scheduled-backup
run security-context
run self-healing-chaos
run service-per-pod
run serviceless-external-nodes
run smart-update
run storage
run upgrade-consistency
run upgrade-consistency-sharded
run upgrade-sharded
run upgrade
run users
run vector-search
run vector-search-sharded
run version-service
