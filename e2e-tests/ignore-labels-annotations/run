#!/bin/bash

set -o errexit
set -o xtrace

test_dir=$(realpath "$(dirname "$0")")
. "${test_dir}/../functions"

create_infra "$namespace"
cluster="some-name"

apply_cluster "$test_dir/conf/$cluster.yml"
desc 'check if all 3 Pods started'
wait_for_running "$cluster-rs0" 3

check_headless_svc_has_no_expose_annotations() {
	local headless_svc=$1
	shift
	local keys=("$@")

	if [[ -z $headless_svc ]]; then
		return
	fi

	local key
	local actual
	for key in "${keys[@]}"; do
		actual=$(kubectl_bin get "service/$headless_svc" -o json) || return 1
		actual=$(jq -r ".metadata.annotations[\"$key\"] // \"\"" <<<"$actual") || return 1
		if [[ -n $actual ]]; then
			desc "FAIL: headless service $headless_svc must never get expose.annotations key \"$key\" applied, but got \"$actual\""
			exit 1
		fi
	done
}

# operator restores service metadata on its next reconcile, which may be
# delayed (e.g. by an update conflict), so retry instead of relying on sleep
wait_compare_kubectl() {
	local resource=$1
	local postfix=$2
	local retries=${3:-12}

	for _ in $(seq 1 "$retries"); do
		if (compare_kubectl "$resource" "$postfix" >/dev/null 2>&1); then
			break
		fi
		sleep 5
	done
	compare_kubectl "$resource" "$postfix"
}

check_service() {
	replset_name=$1

	local expose_path
	local svc_name
	local headless_svc_name=""
	case $replset_name in

		"rs0")
			expose_path="/spec/replsets/0/expose"
			svc_name="$cluster-rs0-0"
			headless_svc_name="$cluster-rs0"
			;;

		"cfg")
			expose_path="/spec/sharding/configsvrReplSet/expose"
			svc_name="$cluster-cfg-0"
			headless_svc_name="$cluster-cfg"
			;;

		"mongos")
			expose_path="/spec/sharding/mongos/expose"
			svc_name="$cluster-mongos-0"
			# mongos has no headless counterpart, nothing to check
			headless_svc_name=""
			;;

		*)
			desc 'unknown check_service argument'
			exit 1
			;;
	esac

	desc "add labels and annotation manually to service $svc_name"
	# `notIgnoredLabel` and `notIgnoredAnnotation` should be deleted
	kubectl_bin patch "service/$svc_name" --type=json --patch '[
        {
            "op": "add",
            "path": "/metadata/labels/notIgnoredLabel",
            "value": "true"
        },
        {
            "op": "add",
            "path": "/metadata/labels/ignoredLabel",
            "value": "true"
        },
        {
            "op": "add",
            "path": "/metadata/annotations/notIgnoredAnnotation",
            "value": "true"
        },
        {
            "op": "add",
            "path": "/metadata/annotations/ignoredAnnotation",
            "value": "true"
        }]'

	sleep 7 # waiting for reconcile
	desc "check if annotations/labels are not deleted from service $svc_name"
	wait_compare_kubectl "service/$svc_name" "-manual"

	desc "adding ignoreAnnotations and ignoreLabels"
	kubectl_bin patch psmdb "$cluster" --type=json --patch '[
        {
            "op": "add",
            "path": "/spec/ignoreAnnotations",
            "value": ["ignoredAnnotation"]
        },
        {
            "op": "add",
            "path": "/spec/ignoreLabels",
            "value": ["ignoredLabel"]
        }
    ]'
	sleep 7
	desc "check if annotations/labels are not deleted from service $svc_name"
	wait_compare_kubectl "service/$svc_name" "-manual"

	desc "adding labels and annotations to $expose_path"
	kubectl_bin patch psmdb ${cluster} --type=json --patch '[
        {
            "op": "replace", 
            "path": "'$expose_path'/labels", 
			"value": {
				"crLabel": "true",
			}
        },
        {
            "op": "replace", 
            "path": "'$expose_path'/annotations", 
			"value": {
				"crAnnotation": "true",
			}
        }]'
	sleep 5
	desc "check if not ignored labels and annotations are deleted from service $svc_name"
	wait_compare_kubectl "service/$svc_name" "-crmeta"

	desc "check that expose.annotations are never applied to the headless service $headless_svc_name"
	check_headless_svc_has_no_expose_annotations "$headless_svc_name" "crAnnotation"

	desc "removing labels and annotations from $expose_path"
	kubectl_bin patch psmdb ${cluster} --type=json --patch '[
        {
            "op": "remove", 
            "path": "'$expose_path'/labels"
        },
        {
            "op": "remove", 
            "path": "'$expose_path'/annotations"
        }]'
	sleep 5
	desc "check if labels and annotations are not deleted from service $svc_name"
	wait_compare_kubectl "service/$svc_name" "-crmeta"

	desc "adding other labels and annotations to $expose_path"
	kubectl_bin patch psmdb ${cluster} --type=json --patch '[
        {
            "op": "replace", 
            "path": "'$expose_path'/labels", 
			"value": {
				"otherCrLabel": "true",
				"secondCrLabel": "true",
			}
        },
		{
            "op": "replace", 
            "path": "'$expose_path'/annotations", 
			"value": {
				"otherCrAnnotation": "true",
				"secondCrAnnotation": "true",
			}
		}]'
	sleep 5
	desc "check if not previous service labels and annotations is deleted from $svc_name"
	wait_compare_kubectl "service/$svc_name" "-two-service-labels-annotations"

	desc "check that expose.annotations are still never applied to the headless service $headless_svc_name"
	check_headless_svc_has_no_expose_annotations "$headless_svc_name" "otherCrAnnotation" "secondCrAnnotation"

	desc "adding removing one labels from $expose_path"
	kubectl_bin patch psmdb ${cluster} --type=json --patch '[
        {
            "op": "replace", 
            "path": "'$expose_path'/labels", 
			"value": {
				"otherCrLabel": "true",
			}
        },
        {
            "op": "replace", 
            "path": "'$expose_path'/annotations", 
			"value": {
				"otherCrAnnotation": "true",
			}
        }]'
	sleep 5
	desc "check if removed service label is deleted from $svc_name"
	wait_compare_kubectl "service/$svc_name" "-one-service-label-annotation"

	desc "removing ignoreLabels and ignoreAnnotations"
	# When `labels` and `annotations` are not set, old metadata should stay
	kubectl_bin patch psmdb ${cluster} --type=json --patch '[
        {
            "op": "remove", 
            "path": "/spec/ignoreAnnotations",
        },
        {
            "op": "remove", 
            "path": "/spec/ignoreLabels",
        }]'

	sleep 5 # waiting for reconcile
	desc "check if ignored labels and annotations are deleted from $svc_name"
	wait_compare_kubectl "service/$svc_name" "-no-ignored-meta"
}

check_service "rs0"
check_service "cfg"
check_service "mongos"

destroy "$namespace"

desc 'test passed'
