#!/bin/bash
# e2e test for VPA integration using Goldilocks as the recommendation source.
#
# This test validates the FULL cycle:
#   Goldilocks watches the namespace
#     → creates VPA objects (named after each StatefulSet)
#       → VPA Recommender collects metrics and writes recommendations
#         → Operator reads status.recommendation
#           → records in status.vpaStatus
#             → applies to CR (Auto mode) → SmartUpdate converges
#
# Requirements:
#   - Helm available in $PATH
#   - metrics-server running in the cluster (standard on most managed K8s)
#   - Internet access to pull Goldilocks and VPA images (or pre-pull in CI)
#
# Note: VPA Recommender needs several minutes of pod metrics to produce its
# first recommendation. This test uses a generous timeout (VPA_TIMEOUT=900s).

set -o errexit

test_dir=$(realpath "$(dirname "$0")")
. "${test_dir}/../functions"
set_debug

cluster="some-name"
goldilocks_ns="goldilocks"

# How long to wait for VPA Recommender to produce a recommendation (seconds).
# In practice the first recommendation appears within 3-8 minutes once pods
# are running and metrics-server has data.
VPA_TIMEOUT=${VPA_TIMEOUT:-900}
VPA_POLL_INTERVAL=20

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

function install_vpa_recommender() {
	desc 'install VPA CRDs and Recommender (no Admission Controller, no Updater)'

	# CRDs
	retry 5 10 kubectl_bin apply -f \
		https://raw.githubusercontent.com/kubernetes/autoscaler/master/vertical-pod-autoscaler/deploy/vpa-v1-crd-gen.yaml

	kubectl_bin wait crd/verticalpodautoscalers.autoscaling.k8s.io \
		--for=condition=Established --timeout=60s

	# RBAC (service accounts, ClusterRoles, ClusterRoleBindings required by recommender)
	retry 5 10 kubectl_bin apply -f \
		https://raw.githubusercontent.com/kubernetes/autoscaler/master/vertical-pod-autoscaler/deploy/vpa-rbac.yaml

	# Recommender only — the only component that calculates recommendations
	retry 5 10 kubectl_bin apply -f \
		https://raw.githubusercontent.com/kubernetes/autoscaler/master/vertical-pod-autoscaler/deploy/recommender-deployment.yaml

	desc 'wait for VPA Recommender to be ready'
	kubectl_bin rollout status deployment/vpa-recommender \
		-n kube-system --timeout=120s
}

function install_goldilocks() {
	desc 'install Goldilocks via Helm'

	helm repo add fairwinds-stable https://charts.fairwinds.com/stable 2>/dev/null || true
	helm repo update fairwinds-stable

	# Install into its own namespace; disable bundled VPA since we installed it above
	retry 5 30 helm upgrade --install goldilocks fairwinds-stable/goldilocks \
		--namespace "${goldilocks_ns}" \
		--create-namespace \
		--set vpa.enabled=false \
		--wait \
		--timeout 120s

	desc 'wait for Goldilocks controller to be ready'
	kubectl_bin rollout status deployment/goldilocks-controller \
		-n "${goldilocks_ns}" --timeout=120s
}

function uninstall_goldilocks() {
	helm uninstall goldilocks --namespace "${goldilocks_ns}" 2>/dev/null || true
	kubectl_bin delete namespace "${goldilocks_ns}" --ignore-not-found
}

function label_namespace_for_goldilocks() {
	desc "label namespace ${namespace} so Goldilocks watches it"
	kubectl_bin label namespace "${namespace}" \
		goldilocks.fairwinds.com/enabled=true --overwrite
}

function wait_for_goldilocks_vpa_object() {
	local vpa_name=$1
	local max_retry=30
	local sleep_time=10

	desc "wait for Goldilocks to create VPA object '${vpa_name}'"
	local retry=0
	until kubectl_bin get vpa "${vpa_name}" -n "${namespace}" &>/dev/null; do
		if [[ $retry -ge $max_retry ]]; then
			echo
			echo "ERROR: VPA object '${vpa_name}' was not created by Goldilocks"
			kubectl_bin get vpa -n "${namespace}" || true
			exit 1
		fi
		echo -n "."
		sleep $sleep_time
		retry=$((retry + 1))
	done
	echo
	echo "OK: VPA object '${vpa_name}' created by Goldilocks"
}

function wait_for_vpa_recommendation() {
	local vpa_name=$1
	local container=${2:-mongod}

	desc "wait for VPA Recommender to produce recommendation for '${vpa_name}' (timeout ${VPA_TIMEOUT}s)"
	echo "This may take several minutes — VPA Recommender needs metrics history."

	local elapsed=0
	until kubectl_bin get vpa "${vpa_name}" -n "${namespace}" \
		-o jsonpath="{.status.recommendation.containerRecommendations[?(@.containerName==\"${container}\")].target.cpu}" \
		2>/dev/null | grep -q .; do
		if [[ $elapsed -ge $VPA_TIMEOUT ]]; then
			echo
			echo "ERROR: VPA Recommender did not produce a recommendation within ${VPA_TIMEOUT}s"
			echo "VPA object status:"
			kubectl_bin get vpa "${vpa_name}" -n "${namespace}" -o yaml || true
			echo "VPA Recommender logs (last 50 lines):"
			kubectl_bin logs -n kube-system \
				-l app=vpa-recommender --tail=50 || true
			exit 1
		fi
		echo -n "."
		sleep $VPA_POLL_INTERVAL
		elapsed=$((elapsed + VPA_POLL_INTERVAL))
	done
	echo

	local cpu memory
	cpu=$(kubectl_bin get vpa "${vpa_name}" -n "${namespace}" \
		-o jsonpath="{.status.recommendation.containerRecommendations[?(@.containerName==\"${container}\")].target.cpu}")
	memory=$(kubectl_bin get vpa "${vpa_name}" -n "${namespace}" \
		-o jsonpath="{.status.recommendation.containerRecommendations[?(@.containerName==\"${container}\")].target.memory}")
	echo "OK: VPA Recommender recommendation — cpu=${cpu} memory=${memory}"
}

function wait_for_vpa_status_populated() {
	local status_key=$1
	local max_retry=30
	local sleep_time=10

	desc "wait for operator to record VPA recommendation in status.vpaStatus.${status_key}"
	local retry=0
	until kubectl_bin get psmdb "${cluster}" \
		-o jsonpath="{.status.vpaStatus.${status_key}.cpu}" \
		2>/dev/null | grep -q .; do
		if [[ $retry -ge $max_retry ]]; then
			echo
			echo "ERROR: status.vpaStatus.${status_key}.cpu was not populated"
			kubectl_bin get psmdb "${cluster}" \
				-o jsonpath='{.status.vpaStatus}' | jq . || true
			exit 1
		fi
		echo -n "."
		sleep $sleep_time
		retry=$((retry + 1))
	done
	echo

	local cpu memory
	cpu=$(kubectl_bin get psmdb "${cluster}" \
		-o jsonpath="{.status.vpaStatus.${status_key}.cpu}")
	memory=$(kubectl_bin get psmdb "${cluster}" \
		-o jsonpath="{.status.vpaStatus.${status_key}.memory}")
	echo "OK: status.vpaStatus.${status_key} — cpu=${cpu} memory=${memory}"
}

function wait_for_last_applied_at() {
	local status_key=$1
	local max_retry=30
	local sleep_time=10

	desc "wait for operator to apply recommendation (status.vpaStatus.${status_key}.lastAppliedAt)"
	local retry=0
	until kubectl_bin get psmdb "${cluster}" \
		-o jsonpath="{.status.vpaStatus.${status_key}.lastAppliedAt}" \
		2>/dev/null | grep -q .; do
		if [[ $retry -ge $max_retry ]]; then
			echo
			echo "ERROR: lastAppliedAt for '${status_key}' was never set"
			kubectl_bin get psmdb "${cluster}" \
				-o jsonpath='{.status.vpaStatus}' | jq . || true
			exit 1
		fi
		echo -n "."
		sleep $sleep_time
		retry=$((retry + 1))
	done
	echo
	echo "OK: lastAppliedAt set for ${status_key}"
}

function assert_cr_requests_changed() {
	local resource=$1
	local original=$2

	local current
	current=$(kubectl_bin get psmdb "${cluster}" \
		-o jsonpath="{.spec.replsets[0].resources.requests.${resource}}")

	if [[ "${current}" == "${original}" ]]; then
		echo "ERROR: spec.replsets[0].resources.requests.${resource} was not changed from '${original}'"
		exit 1
	fi
	echo "OK: spec.replsets[0].resources.requests.${resource} changed: '${original}' → '${current}'"
}

# ---------------------------------------------------------------------------
# setup
# ---------------------------------------------------------------------------

create_infra "${namespace}"

desc 'install VPA Recommender and Goldilocks before cluster creation'
install_vpa_recommender
install_goldilocks

desc 'create secrets and psmdb client'
kubectl_bin apply \
	-f "${conf_dir}/secrets.yml" \
	-f "${conf_dir}/client.yml"

desc "deploy PSMDB cluster ${cluster} with vpa.updateMode=Off"
apply_cluster "${test_dir}/conf/${cluster}.yml"
desc 'wait for cluster pods to be ready'
wait_for_running "${cluster}-rs0" 3
sleep 15

label_namespace_for_goldilocks

# ---------------------------------------------------------------------------
# phase 1: wait for Goldilocks to create VPA objects and Recommender to fill them
# ---------------------------------------------------------------------------

desc '=== PHASE 1: Goldilocks → VPA Recommender → recommendation ==='

# Goldilocks names VPA objects with a "goldilocks-" prefix: goldilocks-<statefulset-name>.
# The cluster CR sets vpa.objectName: goldilocks-some-name-rs0 to match this.
goldilocks_vpa_name="goldilocks-${cluster}-rs0"
wait_for_goldilocks_vpa_object "${goldilocks_vpa_name}"

desc 'verify Goldilocks created VPA object with updateMode=Off'
vpa_mode=$(kubectl_bin get vpa "${goldilocks_vpa_name}" -n "${namespace}" \
	-o jsonpath='{.spec.updatePolicy.updateMode}')
if [[ "${vpa_mode}" != "Off" ]]; then
	echo "WARNING: Goldilocks VPA updateMode is '${vpa_mode}', expected 'Off'"
fi
echo "VPA object updatePolicy.updateMode: ${vpa_mode}"

desc 'wait for VPA Recommender to produce recommendation (requires metrics history)'
wait_for_vpa_recommendation "${goldilocks_vpa_name}" "mongod"

# ---------------------------------------------------------------------------
# phase 2: Off mode — operator records in status, CR unchanged
# ---------------------------------------------------------------------------

desc '=== PHASE 2: Off mode — status populated, CR resources unchanged ==='

wait_for_vpa_status_populated "rs0"

desc 'verify CR resources NOT changed in Off mode'
current_cpu=$(kubectl_bin get psmdb "${cluster}" \
	-o jsonpath='{.spec.replsets[0].resources.requests.cpu}')
if [[ "${current_cpu}" != "100m" ]]; then
	echo "ERROR: CR cpu requests changed in Off mode: expected '100m', got '${current_cpu}'"
	exit 1
fi
echo "OK: CR resources unchanged in Off mode (cpu=100m)"

desc 'verify lastAppliedAt is nil in Off mode'
last_applied=$(kubectl_bin get psmdb "${cluster}" \
	-o jsonpath='{.status.vpaStatus.rs0.lastAppliedAt}')
if [[ -n "${last_applied}" ]]; then
	echo "ERROR: lastAppliedAt should be empty in Off mode, got '${last_applied}'"
	exit 1
fi
echo "OK: lastAppliedAt is empty in Off mode"

# ---------------------------------------------------------------------------
# phase 3: Auto mode — recommendation applied, cluster converges
# ---------------------------------------------------------------------------

desc '=== PHASE 3: Auto mode — recommendation applied via SmartUpdate ==='

desc 'switch to updateMode=Auto'
kubectl_bin patch psmdb "${cluster}" \
	--type='json' \
	-p='[{"op": "replace", "path": "/spec/vpa/updateMode", "value": "Auto"}]'

wait_for_last_applied_at "rs0"

desc 'verify applied values are within configured bounds'
# The recommendation may be clamped to minAllowed/maxAllowed, so the value might
# not differ from the original. What matters is lastAppliedAt was set (operator applied).
applied_cpu=$(kubectl_bin get psmdb "${cluster}" \
	-o jsonpath='{.spec.replsets[0].resources.requests.cpu}')
applied_mem=$(kubectl_bin get psmdb "${cluster}" \
	-o jsonpath='{.spec.replsets[0].resources.requests.memory}')
echo "Applied: cpu=${applied_cpu} memory=${applied_mem}"
echo "Bounds:  cpu=[100m, 2] memory=[128Mi, 2Gi]"
echo "OK: VPA recommendation applied (lastAppliedAt set, values within bounds)"

desc 'wait for cluster to converge after SmartUpdate'
wait_cluster_consistency "${cluster}" 64

desc 'verify cluster is ready'
kubectl_bin get psmdb "${cluster}" -o jsonpath='{.status.state}' | grep -q "ready"
echo "OK: cluster ready after VPA-driven SmartUpdate"

desc 'print final VPA status'
kubectl_bin get psmdb "${cluster}" -o jsonpath='{.status.vpaStatus}' | jq .

# ---------------------------------------------------------------------------
# cleanup
# ---------------------------------------------------------------------------

destroy "${namespace}"
uninstall_goldilocks

desc 'test passed'
