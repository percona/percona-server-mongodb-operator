#!/bin/bash

set -o errexit

test_dir=$(realpath "$(dirname "$0")")
. "${test_dir}/../functions"

function patch_pvc_request() {
	local cluster=$1
	local size=$2

	echo "Patching PVC request to ${size} in ${cluster}"

	kubectl_bin patch psmdb "${cluster}" --type=json -p='[{"op": "replace", "path": "/spec/replsets/0/volumeSpec/persistentVolumeClaim/resources/requests/storage", "value":"'"${size}"'"}]'
}

function get_default_storageclass() {
	kubectl_bin get sc -o jsonpath='{.items[?(@.metadata.annotations.storageclass\.kubernetes\.io/is-default-class=="true")].metadata.name}'
}

function ensure_default_sc_allows_expansion() {
	local default_sc
	default_sc=$(get_default_storageclass)

	echo "Checking if default storageclass ${default_sc} allows volume expansion"

	local allowVolumeExpansion
	allowVolumeExpansion=$(kubectl_bin get sc -o jsonpath='{.items[?(@.metadata.name=="'"${default_sc}"'")].allowVolumeExpansion}')

	if [[ ${allowVolumeExpansion} != "true" ]]; then
		echo "Default storageclass ${default_sc} does not allow volume expansion"
		exit 0
	fi
}

function apply_resourcequota() {
	local quota=$1
	local default_sc
	default_sc=$(get_default_storageclass)

	echo "Applying resourcequota for default storageclass ${default_sc} with quota ${quota}"

	cat "${test_dir}/conf/resourcequota.yml" \
		| sed "s/STORAGECLASS/${default_sc}/" \
		| sed "s/QUOTA/${quota}/" \
		| kubectl_bin apply -f -
}

function wait_cluster_status() {
	local cluster=$1
	local expected=$2
	local retry=0

	echo -n "Waiting for psmdb/${cluster} status to be ${expected}"
	until [[ $(kubectl_bin get psmdb "${cluster}" -o jsonpath='{.status.state}') == "${expected}" ]]; do
		if [[ $retry -ge 60 ]]; then
			echo
			echo "psmdb/${cluster} did not reach ${expected} status, max retries exceeded"
			exit 1
		fi
		echo -n "."
		sleep 5

		retry=$((retry + 1))
	done

	echo
	echo "psmdb/${cluster} status is ${expected}"
}

function wait_pvc_request_revert() {
	local cluster=$1
	local expected=$2
	local retry=0

	echo -n "Waiting for psmdb/${cluster} storage request to revert to ${expected}"
	until [[ $(kubectl_bin get psmdb "${cluster}" -o jsonpath='{.spec.replsets[0].volumeSpec.persistentVolumeClaim.resources.requests.storage}') == "${expected}" ]]; do
		if [[ $retry -ge 60 ]]; then
			echo
			echo "psmdb/${cluster} storage request did not revert to ${expected}, max retries exceeded"
			exit 1
		fi
		echo -n "."
		sleep 5

		retry=$((retry + 1))
	done

	echo
	echo "psmdb/${cluster} storage request reverted to ${expected}"
}

function spinup_sharded_psmdb() {
	local config=$1

	desc 'create PSMDB cluster'
	apply_cluster "${config}"

	desc 'check if all Pods started'
	wait_for_running "${cluster}-rs0" 3
	wait_for_running "${cluster}-cfg" 3 "false"
	wait_for_running "${cluster}-mongos" 2
	sleep 20

	compare_kubectl "statefulset/${cluster}-rs0"

	desc 'write data'

	run_mongos 'db.createUser({user: "myApp", pwd: "myPass", roles: [{ db: "myApp", role: "readWrite" }]})' \
		"userAdmin:userAdmin123456@${cluster}-mongos.${namespace}"

	run_mongos 'use myApp\n db.test.insert({ x: 100500 })' "myApp:myPass@${cluster}-mongos.${namespace}"
}

function patch_mongos_pvc_request() {
	local cluster=$1
	local size=$2

	echo "Patching mongos log PVC request to ${size} in ${cluster}"

	kubectl_bin patch psmdb "${cluster}" --type=json -p='[{"op": "replace", "path": "/spec/sharding/mongos/logs/persistentVolumeClaim/resources/requests/storage", "value":"'"${size}"'"}]'
}

function wait_mongos_pvc_request_revert() {
	local cluster=$1
	local expected=$2
	local retry=0

	echo -n "Waiting for psmdb/${cluster} mongos log storage request to revert to ${expected}"
	until [[ $(kubectl_bin get psmdb "${cluster}" -o jsonpath='{.spec.sharding.mongos.logs.persistentVolumeClaim.resources.requests.storage}') == "${expected}" ]]; do
		if [[ $retry -ge 60 ]]; then
			echo
			echo "psmdb/${cluster} mongos log storage request did not revert to ${expected}, max retries exceeded"
			exit 1
		fi
		echo -n "."
		sleep 5

		retry=$((retry + 1))
	done

	echo
	echo "psmdb/${cluster} mongos log storage request reverted to ${expected}"
}

set_debug

if [[ "$EKS" -eq 1 ]]; then
	echo "EKS environment detected, creating storageclass for EBS volumes"
	kubectl_bin apply -f "${test_dir}/conf/eks-storageclass.yml"
else
	ensure_default_sc_allows_expansion
fi

create_infra "${namespace}"

desc 'create secrets and psmdb client'
kubectl_bin apply \
	-f "$conf_dir/secrets.yml" \
	-f "$conf_dir/client.yml"

cluster="some-name"

# the cluster is sharded, so cfg PVCs carry the mongod component label as well.
# every assertion on the replset PVCs below is scoped to rs0
rs0_pvc_selector="app.kubernetes.io/component=mongod,app.kubernetes.io/replset=rs0"
mongos_pvc_selector="app.kubernetes.io/component=mongos"

if [[ "$EKS" -eq 1 ]]; then
	spinup_sharded_psmdb "$test_dir/conf/$cluster-eks.yml"
else
	spinup_sharded_psmdb "$test_dir/conf/$cluster.yml"
fi

patch_pvc_request "${cluster}" "2Gi"
wait_cluster_consistency "$cluster"
echo

if wait_all_pvc_resize "2Gi" 120 1 "${rs0_pvc_selector}"; then
	echo "PVC was resized, but resize.expansion is disabled"
	exit 1
fi

echo "Enabling PVC resize"
kubectl_bin patch psmdb "${cluster}" --type=json -p='[{"op": "add", "path": "/spec/storageScaling", "value":{"enableVolumeScaling":true} }]'
sleep 10

wait_cluster_consistency "$cluster"
wait_all_pvc_resize "2Gi" 120 5 "${rs0_pvc_selector}"

echo

if [[ "$EKS" -eq 1 || -n "$OPENSHIFT" ]]; then
	# AWS rate limits PVC expansion for the same EBS volume (1 expand operation in every 6 hours),
	# so we need to delete and recreate the cluster
	echo "Deleting and recreating PSMDB cluster ${cluster}"
	kubectl_bin delete psmdb ${cluster}
	kubectl_bin apply -f "$conf_dir/secrets.yml"
	if [[ "$EKS" -eq 1 ]]; then
		spinup_sharded_psmdb "$test_dir/conf/$cluster-eks.yml"
	else
		spinup_sharded_psmdb "$test_dir/conf/$cluster.yml"
	fi
	echo "Enabling PVC resize after recreating PSMDB cluster ${cluster} "
	kubectl_bin patch psmdb "${cluster}" --type=json -p='[{"op": "add", "path": "/spec/storageScaling", "value":{"enableVolumeScaling":true} }]'
	sleep 10

	wait_cluster_consistency "$cluster"
fi

desc 'create resourcequota'

# rs0 holds 3x2Gi, cfg holds 3x1Gi and the mongos logs hold 2x1Gi, so 11Gi is in
# use. We're setting the quota to 12Gi, so only one rs0 PVC can grow to 3Gi. the
# rest fail with an exceeded quota error, which the operator handles by reverting
# the storage request in the spec back to the configured size and keeping the
# cluster ready

apply_resourcequota 12Gi
patch_pvc_request "${cluster}" "3Gi"

wait_pvc_request_revert "${cluster}" "2Gi"
wait_cluster_status ${cluster} "ready"
echo

# We're setting the quota to 14Gi (3x3Gi for rs0 + 3x1Gi for cfg + 2x1Gi for the
# mongos logs), so we can resize all rs0 PVCs to 3Gi

apply_resourcequota 14Gi
patch_pvc_request "${cluster}" "3Gi"
wait_cluster_consistency "$cluster" 42
echo

wait_all_pvc_resize "3Gi" 120 5 "${rs0_pvc_selector}"

desc "test downscale"

# operator shouldn't downscale the PVCs. instead it reverts the storage request
# in the spec back to the configured size and keeps the cluster ready
patch_pvc_request "${cluster}" "1Gi"
wait_pvc_request_revert "${cluster}" "3Gi"
wait_cluster_status ${cluster} "ready"

if [[ "$EKS" -eq 1 || -n "$OPENSHIFT" ]]; then
	echo "Deleting and recreating PSMDB cluster ${cluster} to avoid cloud storage resize cooldown"
	kubectl_bin delete psmdb ${cluster}
	kubectl_bin apply -f "$conf_dir/secrets.yml"
	if [[ "$EKS" -eq 1 ]]; then
		spinup_sharded_psmdb "$test_dir/conf/$cluster-eks.yml"
	else
		spinup_sharded_psmdb "$test_dir/conf/$cluster.yml"
	fi
	kubectl_bin patch psmdb "${cluster}" --type=json -p='[{"op": "add", "path": "/spec/storageScaling", "value":{"enableVolumeScaling":true} }]'
	sleep 10
	wait_cluster_consistency "$cluster"
fi

desc "test restartedAt annotation preservation during PVC resize"

echo "delete resourcequota"
kubectl_bin delete resourcequota default-storage-quota || true

sts_name="${cluster}-rs0"
kubectl_bin rollout restart statefulset/${sts_name}
wait_for_running ${sts_name} 3

restarted_at_before=$(kubectl_bin get statefulset ${sts_name} -o jsonpath='{.spec.template.metadata.annotations.kubectl\.kubernetes\.io/restartedAt}')
[ -z "$restarted_at_before" ] && { echo "ERROR: restartedAt not found"; exit 1; }

patch_pvc_request "${cluster}" "4Gi"
wait_all_pvc_resize "4Gi" 120 5 "${rs0_pvc_selector}"

sleep_with_log 30 "wait for StatefulSet recreation after orphan delete during PVC resize"

cluster_status=$(kubectl_bin get psmdb "${cluster}" -o jsonpath='{.status.state}')
restarted_at_after=$(kubectl_bin get statefulset ${sts_name} -o jsonpath='{.spec.template.metadata.annotations.kubectl\.kubernetes\.io/restartedAt}')

if [[ "$restarted_at_before" != "$restarted_at_after" ]]; then
	echo "ERROR: restartedAt lost"
	exit 1
fi

if [[ "$cluster_status" == "initializing" ]]; then
	echo "ERROR: SmartUpdate occurred (restartedAt not preserved)"
	exit 1
fi

wait_cluster_status ${cluster} "ready"
wait_for_running ${sts_name} 3

desc "test mongos log PVC resize"

# one log PVC per mongos pod comes with the cluster
if [[ $(kubectl_bin get pvc -l "${mongos_pvc_selector}" -o name | wc -l | tr -d ' ') -ne 2 ]]; then
	echo "expected one log PVC per mongos pod"
	exit 1
fi

wait_all_pvc_resize "1Gi" 120 5 "${mongos_pvc_selector}"

# the mongos log file has to land on the volume the sidecars read, otherwise
# the PVC is just an empty disk
if ! kubectl_bin exec "${cluster}-mongos-0" -c mongos -- test -s /data/db/logs/mongos.log; then
	echo "mongos.log is missing or empty on the log volume"
	exit 1
fi

patch_mongos_pvc_request "${cluster}" "2Gi"
wait_cluster_consistency "$cluster" 42
echo

wait_all_pvc_resize "2Gi" 120 5 "${mongos_pvc_selector}"
kubectl_bin wait --for=create statefulset "${cluster}-mongos" --timeout=60s
kubectl_bin wait --for=jsonpath='{.spec.volumeClaimTemplates[?(@.metadata.name=="mongos-logs")].spec.resources.requests.storage}'=2Gi \
	statefulset "${cluster}-mongos" --timeout=120s

desc "test mongos log PVC downscale"

# as for replsets, the operator shouldn't downscale the PVCs. instead it reverts
# the storage request in the spec back to the configured size and keeps the cluster ready
patch_mongos_pvc_request "${cluster}" "1Gi"
wait_mongos_pvc_request_revert "${cluster}" "2Gi"
wait_cluster_status ${cluster} "ready"

destroy "${namespace}"
desc "test passed"
